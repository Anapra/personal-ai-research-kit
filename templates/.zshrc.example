# --- Personal AI Research Kit Aliases ---

# AgentMemory Management
alias am-start="pm2 start ~/agentmemory/dist/cli.mjs --name 'agentmemory-server' -- --port 3111"
alias am-stop="pm2 stop agentmemory-server"
alias am-logs="pm2 logs agentmemory-server"
alias am-status="pm2 status"

# GCP Sync
alias gcp-push="gcloud storage rsync -r . gs://your-bucket-name/your-project-path"
alias gcp-pull="gcloud storage rsync -r gs://your-bucket-name/your-project-path ."

# Research Pipelines
alias linkedin-search="python3 ~/personal-ai-research-kit/apify/linkedin/linkedin_research_pipeline.py"
alias reddit-monitor="python3 ~/personal-ai-research-kit/apify/reddit/reddit_research_pipeline.py '' 20 monitor"

# --- Gemini CLI Integration ---
# Ensure Gemini CLI is in path
export PATH="$PATH:$HOME/.local/bin"
